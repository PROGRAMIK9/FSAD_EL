{
  "name": "rvce-academic-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "lint": "npm run lint -w client && npm run lint -w server",
    "test": "npm run test -w server",
    "format": "prettier --write server client/src",
    "format:check": "prettier --check server client/src",
    "test:client": "npm run test -w client",
    "test:e2e": "playwright test -c e2e/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.3.3"
  }
}

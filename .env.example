NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://mongo:27017/rvce_academic_hub
# Database name used when MONGODB_URI does not name one (e.g. an Atlas URI ending in /).
# MONGODB_DB=rvce_academic_hub
JWT_SECRET=replace-with-a-long-random-secret-before-use
JWT_TTL=4h
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
ALLOWED_EMAIL_DOMAINS=rvce.edu.in
ALLOWED_EMAILS=
TRUST_PROXY=false
VITE_GOOGLE_CLIENT_ID=
VITE_API_URL=http://localhost:4000/api
# Local development only: enables a sign-in picker that skips Google.
# Ignored when NODE_ENV=production. Never enable on a shared or public server.
DEV_LOGIN=false
